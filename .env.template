# Agent OS Environment Template
# Copy this to ~/.config/agent-os/config.env and fill in your values.
#
# All values below are placeholders — replace them with your own.
# Mark optional variables by keeping the leading # comment character.

# ── Required ──────────────────────────────────────────────────────

# Path to Agent OS installation (set automatically by install.sh)
export AGENT_OS_HOME="$HOME/agent-os"

# LLM provider — one of: openai, anthropic, openrouter
export LLM_PROVIDER="openai"

# Your LLM provider API key — get this from your provider's dashboard
export LLM_API_KEY="your-api-key-here"

# (Optional) Override the default model for your provider
# export LLM_MODEL="gpt-4o"

# ── Optional: Pinecone semantic memory ─────────────────────────────
# Uncomment to enable cross-session vector search.
# Requires a Pinecone account (pinecone.io).

# export PINECONE_API_KEY="your-pinecone-key"
# export PINECONE_INDEX="agent-vault"

# ── Optional: Neo4j graph memory ───────────────────────────────────
# Uncomment to enable relationship-based memory queries.
# Requires a Neo4j instance (neo4j.com).

# export NEO4J_URI="neo4j+s://your-instance.databases.neo4j.io"
# export NEO4J_USER="neo4j"
# export NEO4J_PASSWORD="your-password"

# ── Optional: Hindsight memory bank ────────────────────────────────
# Requires a running Hindsight API +: pip install 'hindsight-client>=0.4.22'
# See memory/adapters/hindsight/ADAPTER.md
# export HINDSIGHT_API_URL="http://127.0.0.1:9177"
# export HINDSIGHT_BANK="your-bank-id"
# export HINDSIGHT_PROFILE="default"

# ── Optional: Knowledge vault ──────────────────────────────────────
# Path to an Obsidian-compatible knowledge vault directory.
# export VAULT_PATH="$HOME/vault"