#!/usr/bin/env bash
# stumble-cleanup — Clean old triage reports and check resolution status.
# Usage: stumble-cleanup
set -euo pipefail
SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
AGENT_OS_HOME="${AGENT_OS_HOME:-$(dirname "$SCRIPT_DIR")}"
exec python3 "$AGENT_OS_HOME/scripts/stumble-cleanup.py" "$@"
