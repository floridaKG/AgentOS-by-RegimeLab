# ── Vault Subsystem ─────────────────────────────────────────────────────────


def cmd_vault_reindex(args: argparse.Namespace) -> None:
    """Reindex knowledge vault to Pinecone."""
    script = "scripts/vault-reindex.sh"
    cmd_args = ["reindex"]
    rc, out = run(script, cmd_args, json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(
        rc, out, json_mode=args.json, command_path=("vault", "reindex"), quiet=args.quiet
    )


def cmd_vault_status(args: argparse.Namespace) -> None:
    """Vault index status."""
    script = "scripts/vault-reindex.sh"
    cmd_args = ["status"]
    rc, out = run(script, cmd_args, json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(
        rc, out, json_mode=args.json, command_path=("vault", "status"), quiet=args.quiet
    )


def cmd_vault_search(args: argparse.Namespace) -> None:
    """Semantic search of the knowledge vault."""
    script = "scripts/vault-reindex.sh"
    cmd_args = ["search", args.query]
    rc, out = run(script, cmd_args, json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(
        rc, out, json_mode=args.json, command_path=("vault", "search"), quiet=args.quiet
    )


# ── Docs Subsystem ──────────────────────────────────────────────────────────


def cmd_docs_index(args: argparse.Namespace) -> None:
    """Index agent-os-docs into Pinecone for semantic retrieval."""
    script = "scripts/docs_index.py"
    cmd_args = [args.action]
    if args.query:
        cmd_args.append(args.query)
    if args.json:
        cmd_args.append("--json")
    rc, out = run(script, cmd_args, json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(
        rc, out, json_mode=args.json, command_path=("docs", "index"), quiet=args.quiet
    )


def cmd_docs_health(args: argparse.Namespace) -> None:
    """Verify agent-os-docs claims against live system state."""
    script = "scripts/doc-health-check.py"
    rc, out = run(script, [], json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(
        rc, out, json_mode=args.json, command_path=("docs", "health"), quiet=args.quiet
    )


# ── Cron Subsystem ──────────────────────────────────────────────────────────


def cmd_cron_health(args: argparse.Namespace) -> None:
    """Validate Agent OS cron fleet."""
    script = "scripts/cron-health-check.py"
    rc, out = run(script, [], json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(
        rc, out, json_mode=args.json, command_path=("cron", "health"), quiet=args.quiet
    )


def cmd_cron_catchup(args: argparse.Namespace) -> None:
    """Run overdue cron jobs after WSL boot."""
    script = "scripts/cron-catchup.sh"
    cmd_args = []
    if args.dry_run:
        cmd_args.append("--dry-run")
    rc, out = run(script, cmd_args, json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(
        rc, out, json_mode=args.json, command_path=("cron", "catchup"), quiet=args.quiet
    )


# ── Voice Subsystem ─────────────────────────────────────────────────────────


def cmd_voice_emit(args: argparse.Namespace) -> None:
    """Emit an Agent Voice insight."""
    script = str(BIN_DIR / "agent-voice")
    cmd_args = ["emit"]
    if args.text:
        cmd_args.extend(["--text", args.text])
    if args.json:
        cmd_args.append("--json")
    rc, out = run(script, cmd_args, json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(
        rc, out, json_mode=args.json, command_path=("voice", "emit"), quiet=args.quiet
    )


