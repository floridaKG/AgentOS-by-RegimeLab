# ── Subcommand Builders ─────────────────────────────────────────────────────


def add_global_flags(parser: argparse.ArgumentParser) -> None:
    """Add global flags inherited by all subcommands."""
    parser.add_argument(
        "--json",
        action="store_true",
        help="Machine-readable JSON output",
    )
    parser.add_argument(
        "-q", "--quiet",
        action="store_true",
        help="Suppress non-error output",
    )
    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="Show detailed command output",
    )


def build_health(sub) -> None:
    p = sub.add_parser("health", help="Full cockpit diagnostic", aliases=["status"], description=cmd_health.__doc__)
    add_global_flags(p)
    p.set_defaults(func=cmd_health)


def build_verify(sub) -> None:
    p = sub.add_parser("verify", help="Deep verification suite", description=cmd_verify.__doc__)
    p.add_argument("suite", nargs="?", choices=["all", "memory", "acp", "refs", "scripts"], help="Verification suite to run")
    add_global_flags(p)
    p.set_defaults(func=cmd_verify)


def build_boot(sub) -> None:
    p = sub.add_parser("boot", help="Boot sequence", description=cmd_boot.__doc__)
    add_global_flags(p)
    p.set_defaults(func=cmd_boot)


def build_sync_check(sub) -> None:
    p = sub.add_parser("sync-check", help="INDEX.md vs on-disk drift report", description=cmd_sync_check.__doc__)
    add_global_flags(p)
    p.set_defaults(func=cmd_sync_check)


def build_acp(sub) -> None:
    p = sub.add_parser("acp", help="ACP dispatch & monitoring", description="Send, monitor, and manage ACP tasks.")
    add_global_flags(p)
    acp_sub = p.add_subparsers(dest="acp_command", metavar="<command>", required=True)

    # acp send
    sp = acp_sub.add_parser("send", help="Dispatch an ACP task", description=cmd_acp_send.__doc__)
    sp.add_argument("role", help="Target role (e.g. agent-os)")
    sp.add_argument("workspace", help="Target workspace")
    sp.add_argument("objective", help="Task objective text")
    sp.add_argument("--wait", action="store_true", help="Wait for completion")
    sp.add_argument("--session", help="Session name")
    sp.add_argument("--wait-timeout", type=int, default=300, help="Wait timeout in seconds")
    add_global_flags(sp)
    sp.set_defaults(func=cmd_acp_send)

    # acp health
    sp = acp_sub.add_parser("health", help="ACP daemon health", description=cmd_acp_health.__doc__)
    add_global_flags(sp)
    sp.set_defaults(func=cmd_acp_health)

def build_memory(sub) -> None:
    p = sub.add_parser("memory", help="Memory operations", description="Search, manage, and monitor Agent OS memory tiers.")
    add_global_flags(p)
    mem_sub = p.add_subparsers(dest="memory_command", metavar="<command>", required=True)

    # memory recall
    sp = mem_sub.add_parser("recall", help="Search across all memory tiers", description=cmd_memory_recall.__doc__)
    sp.add_argument("query", help="Search query")
    sp.add_argument("--tier", help="Memory tier to search")
    sp.add_argument("--semantic", action="store_true", help="Semantic search")
    sp.add_argument("--hybrid", action="store_true", help="Hybrid search")
    sp.add_argument("--explain", action="store_true", help="Explain search results")
    sp.add_argument("--limit", type=int, default=10, help="Max results")
    add_global_flags(sp)
    sp.set_defaults(func=cmd_memory_recall)

    # memory health
    sp = mem_sub.add_parser("health", help="Memory stack health gate", description=cmd_memory_health.__doc__)
    sp.add_argument("--live-export", action="store_true", help="Export live health data")
    sp.add_argument("--golden", action="store_true", help="Compare against golden state")
    add_global_flags(sp)
    sp.set_defaults(func=cmd_memory_health)

    # memory promote
    sp = mem_sub.add_parser("promote", help="Promote ST to LT memory", description=cmd_memory_promote.__doc__)
    sp.add_argument("--dry-run", action="store_true", help="Preview only")
    sp.add_argument("--target", choices=["st-vector", "st-graph", "report"], help="Promotion target")
    sp.add_argument("--limit", type=int, help="Max records to promote")
    add_global_flags(sp)
    sp.set_defaults(func=cmd_memory_promote)

    # memory lifecycle
    sp = mem_sub.add_parser("lifecycle", help="Cross-tier stale detection", description=cmd_memory_lifecycle.__doc__)
    add_global_flags(sp)
    sp.set_defaults(func=cmd_memory_lifecycle)


def build_skill(sub) -> None:
    p = sub.add_parser("skill", help="Skills management", description="Rank, pack, and inject Agent OS skills.")
    add_global_flags(p)
    sk_sub = p.add_subparsers(dest="skill_command", metavar="<command>", required=True)

    # skill rank
    sp = sk_sub.add_parser("rank", help="Rank skills by relevance", description=cmd_skill_rank.__doc__)
    sp.add_argument("query", help="Query to rank skills against")
    sp.add_argument("--top", type=int, default=10, help="Number of results")
    sp.add_argument("--tier", help="Filter by tier")
    add_global_flags(sp)
    sp.set_defaults(func=cmd_skill_rank)

    # skill pack
    sp = sk_sub.add_parser("pack", help="Extract skill sections", description=cmd_skill_pack.__doc__)
    sp.add_argument("name", help="Skill name")
    sp.add_argument("--list-sections", action="store_true", help="List available sections")
    sp.add_argument("--section", help="Extract specific section heading")
    sp.add_argument("--budget", type=int, help="Token budget for output")
    add_global_flags(sp)
    sp.set_defaults(func=cmd_skill_pack)

    # skill context
    sp = sk_sub.add_parser("context", help="Auto-inject skill context", description=cmd_skill_context.__doc__)
    sp.add_argument("text", help="Task text to match against skills")
    sp.add_argument("budget", nargs="?", type=int, help="Token budget")
    add_global_flags(sp)
    sp.set_defaults(func=cmd_skill_context)


def build_stumble(sub) -> None:
    p = sub.add_parser("stumble", help="Stumble management", description="Triage, review, propose, and apply stumble fixes.")
    add_global_flags(p)
    st_sub = p.add_subparsers(dest="stumble_command", metavar="<command>", required=True)

    # stumble triage
    sp = st_sub.add_parser("triage", help="Daily stumble triage", description=cmd_stumble_triage.__doc__)
    add_global_flags(sp)
    sp.set_defaults(func=cmd_stumble_triage)

    # stumble review
    sp = st_sub.add_parser("review", help="Review and decide on stumbles", description=cmd_stumble_review.__doc__)
    sp.add_argument("action", choices=["list", "show", "decide"], help="Review action")
    sp.add_argument("id", nargs="?", help="Stumble ID (for show/decide)")
    sp.add_argument("decision", nargs="?", help="Decision (for decide)")
    add_global_flags(sp)
    sp.set_defaults(func=cmd_stumble_review)

    # stumble propose
    sp = st_sub.add_parser("propose", help="Generate proposals from clusters", description=cmd_stumble_propose.__doc__)
    sp.add_argument("--summary", action="store_true", help="Show brief summary")
    sp.add_argument("--dry-run", action="store_true", help="Preview without writing")
    add_global_flags(sp)
    sp.set_defaults(func=cmd_stumble_propose)

    # stumble apply
    sp = st_sub.add_parser("apply", help="Apply approved proposals", description=cmd_stumble_apply.__doc__)
    sp.add_argument("--dry-run", action="store_true", help="Preview without applying")
    sp.add_argument("--all", action="store_true", help="Apply all pending")
    sp.add_argument("--fingerprint", help="Apply specific fingerprint")
    add_global_flags(sp)
    sp.set_defaults(func=cmd_stumble_apply)

    # stumble cleanup
    sp = st_sub.add_parser("cleanup", help="Clean old triage reports", description=cmd_stumble_cleanup.__doc__)
    add_global_flags(sp)
    sp.set_defaults(func=cmd_stumble_cleanup)


def build_registry(sub) -> None:
    p = sub.add_parser("registry", help="Registry operations", description="Validate and build Agent OS registries.")
    add_global_flags(p)
    reg_sub = p.add_subparsers(dest="registry_command", metavar="<command>", required=True)

    # registry check
    sp = reg_sub.add_parser("check", help="Validate registry YAML files", description=cmd_registry_check.__doc__)
    sp.add_argument("--strict", action="store_true", help="Fail on all issues")
    add_global_flags(sp)
    sp.set_defaults(func=cmd_registry_check)

    # registry build
    sp = reg_sub.add_parser("build", help="Build manifest from registries", description=cmd_registry_build.__doc__)
    sp.add_argument("--dry-run", action="store_true", help="Preview without writing")
    sp.add_argument("--capabilities-only", action="store_true", help="Only capabilities")
    sp.add_argument("--live", action="store_true", help="Include live data")
    add_global_flags(sp)
    sp.set_defaults(func=cmd_registry_build)


def build_quality(sub) -> None:
    p = sub.add_parser("quality", help="Quality gates", description="Run rule-based quality checks.")
    add_global_flags(p)
    q_sub = p.add_subparsers(dest="quality_command", metavar="<command>", required=True)

    sp = q_sub.add_parser("gates", help="Run quality gates", description=cmd_quality_gates.__doc__)
    sp.add_argument("--check", choices=["stale", "contradictions", "completion", "all"], help="Specific check to run")
    sp.add_argument("--compact", action="store_true", help="Compact cron-friendly output")
    add_global_flags(sp)
    sp.set_defaults(func=cmd_quality_gates)


def build_voice(sub) -> None:
    p = sub.add_parser("voice", help="Agent Voice insights", description="Emit and list Agent Voice insights.")
    add_global_flags(p)
    vo_sub = p.add_subparsers(dest="voice_command", metavar="<command>", required=True)

    sp = vo_sub.add_parser("emit", help="Emit an insight", description=cmd_voice_emit.__doc__)
    sp.add_argument("--text", help="Insight text (omit for interactive)")
    add_global_flags(sp)
    sp.set_defaults(func=cmd_voice_emit)

    sp = vo_sub.add_parser("list", help="List insights", description=cmd_voice_list.__doc__)
    add_global_flags(sp)
    sp.set_defaults(func=cmd_voice_list)


# ── Main ────────────────────────────────────────────────────────────────────


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="agent-os",
        description="Agent OS — unified CLI for the agent orchestration framework.\n"
        "\n"
        "Examples:\n"
        "  agent-os health --json\n"
        "  agent-os memory recall \"boot protocol\"\n"
        "  agent-os acp send agent-os review \"Check the system\"\n"
        "  agent-os skill rank \"memory ops\" --top 5 --json\n"
        "  agent-os registry check --json",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    sub = parser.add_subparsers(dest="command", metavar="<command>")
    sub.required = False

    build_health(sub)
    build_verify(sub)
    build_boot(sub)
    build_sync_check(sub)
    build_acp(sub)
    build_memory(sub)
    build_skill(sub)
    build_stumble(sub)
    build_registry(sub)
    build_quality(sub)
    build_voice(sub)

    if len(sys.argv) <= 1:
        parser.print_help()
        sys.exit(EXIT_USAGE)

    # Handle --json, --quiet, --verbose at top level before subcommand parsing
    # They'll be parsed by the subparser, but we want the main parser to be aware too.

    args = parser.parse_args()

    if not hasattr(args, "func"):
        parser.print_help()
        sys.exit(EXIT_USAGE)

    try:
        args.func(args)
    except Exception as e:
        die(str(e), EXIT_ERROR)


if __name__ == "__main__":
    main()
