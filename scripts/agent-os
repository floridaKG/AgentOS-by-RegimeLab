# ── Memory Subsystem ────────────────────────────────────────────────────────


def cmd_memory_recall(args: argparse.Namespace) -> None:
    """Search across all memory tiers."""
    if args.json:
        # Use memory-recall-safe.py for JSON output
        script = "scripts/memory-recall-safe.py"
        cmd_args = ["--text", args.query]
        if args.limit:
            cmd_args.extend(["--limit", str(args.limit)])
        rc, out = run(
            script, cmd_args, json_mode=True, quiet=args.quiet, verbose=args.verbose
        )
        handle_output(
            rc, out, json_mode=True, command_path=("memory", "recall"), quiet=args.quiet
        )
        return

    script = "scripts/recall.sh"
    cmd_args = [args.query]
    if args.tier:
        cmd_args.extend(["--tier", args.tier])
    if args.semantic:
        cmd_args.append("--semantic")
    if args.hybrid:
        cmd_args.append("--hybrid")
    if args.explain:
        cmd_args.append("--explain")
    rc, out = run(script, cmd_args, json_mode=False, quiet=args.quiet, verbose=args.verbose)
    handle_output(rc, out, json_mode=False, command_path=("memory", "recall"), quiet=args.quiet)


