# ── ACP Subsystem ───────────────────────────────────────────────────────────


def cmd_acp_send(args: argparse.Namespace) -> None:
    """Dispatch an ACP task to a role in a workspace."""
    script = str(BIN_DIR / "acp-task")
    cmd_args = [args.role, args.workspace, args.objective]
    if args.wait:
        cmd_args.append("--wait")
    if args.session:
        cmd_args.extend(["--session", args.session])
    if args.wait_timeout:
        cmd_args.extend(["--wait-timeout", str(args.wait_timeout)])
    rc, out = run(script, cmd_args, json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(rc, out, json_mode=args.json, command_path=("acp", "send"), quiet=args.quiet)


def cmd_acp_health(args: argparse.Namespace) -> None:
    """Report ACP daemon health."""
    script = str(BIN_DIR / "acp-health")
    cmd_args = []
    if args.json:
        cmd_args.append("--json")
    if args.quiet:
        cmd_args.append("--clean")
    rc, out = run(script, cmd_args, json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(
        rc, out, json_mode=args.json, command_path=("acp", "health"), quiet=args.quiet
    )


# ── Memory Subsystem ────────────────────────────────────────────────────────


def cmd_memory_recall(args: argparse.Namespace) -> None:
    """Search across all memory tiers."""
    if args.json:
        # Use memory-recall-safe.py for JSON output
        script = "scripts/memory-recall-safe.py"
        cmd_args = ["--text", args.query]
        if args.limit:
            cmd_args.extend(["--limit", str(args.limit)])
        rc, out = run(
            script, cmd_args, json_mode=True, quiet=args.quiet, verbose=args.verbose
        )
        handle_output(
            rc, out, json_mode=True, command_path=("memory", "recall"), quiet=args.quiet
        )
        return

    script = "scripts/recall.sh"
    cmd_args = [args.query]
    if args.tier:
        cmd_args.extend(["--tier", args.tier])
    if args.semantic:
        cmd_args.append("--semantic")
    if args.hybrid:
        cmd_args.append("--hybrid")
    if args.explain:
        cmd_args.append("--explain")
    rc, out = run(script, cmd_args, json_mode=False, quiet=args.quiet, verbose=args.verbose)
    handle_output(rc, out, json_mode=False, command_path=("memory", "recall"), quiet=args.quiet)


def cmd_memory_health(args: argparse.Namespace) -> None:
    """Memory stack health gate with tier distinction."""
    script = "scripts/memory-health-gate.py"
    cmd_args = []
    if args.json:
        cmd_args.append("--json")
    if args.live_export:
        cmd_args.append("--live-export")
    if args.golden:
        cmd_args.append("--golden")
    rc, out = run(script, cmd_args, json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(
        rc, out, json_mode=args.json, command_path=("memory", "health"), quiet=args.quiet
    )


def cmd_memory_promote(args: argparse.Namespace) -> None:
    """Promote short-term memory to long-term memory."""
    script = str(BIN_DIR / "memory-promote")
    cmd_args = []
    if args.dry_run:
        cmd_args.append("--dry-run")
    if args.target:
        cmd_args.extend(["--target", args.target])
    if args.limit:
        cmd_args.extend(["--limit", str(args.limit)])
    if args.json:
        cmd_args.append("--json")
    rc, out = run(script, cmd_args, json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(
        rc, out, json_mode=args.json, command_path=("memory", "promote"), quiet=args.quiet
    )


def cmd_memory_lifecycle(args: argparse.Namespace) -> None:
