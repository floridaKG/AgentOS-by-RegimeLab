#!/usr/bin/env python3
"""Agent OS — unified CLI for the Agent OS orchestration framework.

Usage:
    agent-os <command> [options] [args]

Top-level commands:
    doctor           One-verdict health check
    health|status    Full cockpit diagnostic
    verify           Deep verification suite
    boot             Boot sequence
    sync-check       INDEX.md vs on-disk drift report
    render           Regenerate INDEX.md from registries
    acp              ACP dispatch & monitoring
    memory           Memory operations
    skill            Skills management
    stumble          Stumble management
    registry         Registry operations
    quality          Quality gates
    vault            Knowledge vault operations
    docs             Documentation operations
    cron             Cron fleet operations
    voice            Agent Voice insights
    handoff          Handoff lifecycle
    research         Research collection

Global flags:
    --json           Machine-readable JSON output
    --quiet, -q      Suppress non-error output
    --verbose, -v    Show detailed command output
    --help           Show help for any command

Examples:
    agent-os doctor
    agent-os health --json
    agent-os acp send agent-os review "Check the system"
    agent-os memory recall "boot protocol" --json
    agent-os skill rank "memory operations" --top 5
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from textwrap import dedent

# ── Constants ──────────────────────────────────────────────────────────────

SCRIPT_DIR = Path(__file__).resolve().parent
AGENT_OS_DIR = SCRIPT_DIR.parent
BIN_DIR = AGENT_OS_DIR / "bin"

EXIT_OK = 0
EXIT_WARN = 1
EXIT_ERROR = 2
EXIT_USAGE = 64

# Scripts that natively support --json (pass through rather than envelope)
NATIVE_JSON_COMMANDS: set[tuple[str, ...]] = {
    ("memory", "health"),
    ("memory", "lifecycle"),
    ("skill", "rank"),
    ("acp", "health"),
    ("registry", "check"),
    ("quality", "gates"),
    ("stumble", "propose"),
}

# ── Helpers ────────────────────────────────────────────────────────────────


def _resolve(script: str) -> Path:
    """Resolve a script path relative to agent-os directory."""
    p = Path(script)
    if p.is_absolute():
        return p
    return AGENT_OS_DIR / script


def run(
    script: str,
    args: list[str],
    *,
    json_mode: bool = False,
    quiet: bool = False,
    verbose: bool = False,
) -> tuple[int, str]:
    """Run a script and return (exit_code, output).

    The script path is resolved relative to AGENT_OS_DIR. If json_mode is
    True and the script is known to support --json natively, the flag is
    appended.
    """
    script_path = _resolve(script)
    if not script_path.exists():
        msg = f"error: required script not found: {script_path}"
        return EXIT_ERROR, msg

    cmd = [str(script_path)] + args
    try:
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=120,
        )
    except subprocess.TimeoutError:
        return EXIT_ERROR, "error: command timed out"

    output = result.stdout
    if result.stderr:
        if output and not output.endswith("\n"):
            output += "\n"
        output += result.stderr

    return result.returncode, output


def json_envelope(
    status: str,
    output: str,
    exit_code: int = 0,
    command: str | None = None,
    error: str | None = None,
    **extra,
) -> str:
    """Wrap non-JSON output in a standard envelope dict."""
    envelope: dict = {
        "status": status,
        "exit_code": exit_code,
        "output": output,
    }
    if command:
        envelope["command"] = command
    if error:
        envelope["error"] = error
    envelope.update(extra)
    return json.dumps(envelope, indent=2)


def handle_output(
    exit_code: int,
    output: str,
    *,
    json_mode: bool,
    command_path: tuple[str, ...],
    quiet: bool = False,
) -> None:
    """Print output in the requested format, then exit."""
    if json_mode and command_path in NATIVE_JSON_COMMANDS:
        # Script natively supports JSON — pass through if valid
        try:
            parsed = json.loads(output)
            print(json.dumps(parsed, indent=2))
            sys.exit(exit_code)
        except json.JSONDecodeError:
            pass  # fall through to envelope

    if json_mode:
        # Wrap in envelope
        status = "ok"
        if exit_code == EXIT_WARN:
            status = "warn"
        elif exit_code >= EXIT_ERROR:
            status = "error"
        envelope = json_envelope(
            status=status,
            output=output,
            exit_code=exit_code,
            command="/".join(command_path),
        )
        print(envelope)
        sys.exit(exit_code if exit_code < EXIT_USAGE else EXIT_ERROR)

    # Human-readable output
    if quiet and exit_code == EXIT_OK and output.strip():
        return
    if output.strip():
        sys.stdout.write(output)
        if not output.endswith("\n"):
            sys.stdout.write("\n")
    sys.exit(exit_code)


def die(message: str, exit_code: int = EXIT_USAGE) -> None:
    """Print an error message and exit."""
    print(f"error: {message}", file=sys.stderr)
    sys.exit(exit_code)


# ── Health / Status ────────────────────────────────────────────────────────


def cmd_health(args: argparse.Namespace) -> None:
    """Full cockpit diagnostic (file structure, scripts, venv, secrets)."""
    script = "scripts/agent-os-health.sh"
    rc, out = run(script, [], json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(rc, out, json_mode=args.json, command_path=("health",), quiet=args.quiet)


# ── Verify ──────────────────────────────────────────────────────────────────


def cmd_verify(args: argparse.Namespace) -> None:
    """Deep verification suite (memory, ACP, docs, scripts)."""
    script = "scripts/agent-os-verify.sh"
    cmd_args = []
    if args.suite:
        cmd_args.append(args.suite)
    rc, out = run(script, cmd_args, json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(rc, out, json_mode=args.json, command_path=("verify",), quiet=args.quiet)


# ── Boot ────────────────────────────────────────────────────────────────────


def cmd_boot(args: argparse.Namespace) -> None:
    """Boot sequence — sources config, verifies secrets, prints health banner."""
    script = "scripts/agent-os-boot.sh"
    rc, out = run(script, [], json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(rc, out, json_mode=args.json, command_path=("boot",), quiet=args.quiet)


