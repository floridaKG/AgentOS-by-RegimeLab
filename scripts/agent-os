# ── Handoff Subsystem ───────────────────────────────────────────────────────


def cmd_handoff_lint(args: argparse.Namespace) -> None:
    """Check active handoffs for staleness."""
    script = str(BIN_DIR / "handoff-lint")
    cmd_args = []
    if args.stale:
        cmd_args.append("--stale")
    if args.root:
        cmd_args.extend(["--root", args.root])
    rc, out = run(script, cmd_args, json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(
        rc, out, json_mode=args.json, command_path=("handoff", "lint"), quiet=args.quiet
    )


def cmd_handoff_boot(args: argparse.Namespace) -> None:
    """Handoff lifecycle boot protocol."""
    script = str(BIN_DIR / "handoff-lifecycle-boot.sh")
    cmd_args = []
    if args.apply:
        cmd_args.append("--apply")
    if args.root:
        cmd_args.extend(["--root", args.root])
    if args.quiet:
        cmd_args.append("--quiet")
    rc, out = run(script, cmd_args, json_mode=args.json, quiet=args.quiet, verbose=args.verbose)
    handle_output(
        rc, out, json_mode=args.json, command_path=("handoff", "boot"), quiet=args.quiet
    )


