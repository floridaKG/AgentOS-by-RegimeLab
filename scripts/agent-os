def build_research(sub) -> None:
    p = sub.add_parser("research", help="Research collection", description="Bounded research fetch with allow-list.")
    add_global_flags(p)
    r_sub = p.add_subparsers(dest="research_command", metavar="<command>", required=True)

    sp = r_sub.add_parser("collect", help="Collect research on a topic", description=cmd_research_collect.__doc__)
    sp.add_argument("query", help="Research query")
    add_global_flags(sp)
    sp.set_defaults(func=cmd_research_collect)


# ── Main ────────────────────────────────────────────────────────────────────


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="agent-os",
        description="Agent OS — unified CLI for the agent orchestration framework.\n"
        "Dispatch to ~70+ scripts across 18 subsystems.\n"
        "\n"
        "Examples:\n"
        "  agent-os doctor\n"
        "  agent-os health --json\n"
        "  agent-os memory recall \"boot protocol\"\n"
        "  agent-os acp send agent-os review \"Check the system\"\n"
        "  agent-os skill rank \"memory ops\" --top 5 --json\n"
        "  agent-os registry check --json",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    sub = parser.add_subparsers(dest="command", metavar="<command>")
    sub.required = False

    build_doctor(sub)
    build_health(sub)
    build_verify(sub)
    build_boot(sub)
    build_sync_check(sub)
    build_render(sub)
    build_acp(sub)
    build_memory(sub)
    build_skill(sub)
    build_stumble(sub)
    build_registry(sub)
    build_quality(sub)
    build_vault(sub)
    build_docs(sub)
    build_cron(sub)
    build_voice(sub)
    build_handoff(sub)
    build_research(sub)

    if len(sys.argv) <= 1:
        parser.print_help()
        sys.exit(EXIT_USAGE)

    # Handle --json, --quiet, --verbose at top level before subcommand parsing
    # They'll be parsed by the subparser, but we want the main parser to be aware too.

    args = parser.parse_args()

    if not hasattr(args, "func"):
        parser.print_help()
        sys.exit(EXIT_USAGE)

    try:
        args.func(args)
    except Exception as e:
        die(str(e), EXIT_ERROR)


if __name__ == "__main__":
    main()
