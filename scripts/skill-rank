#!/usr/bin/env bash
# skill-rank: Rank skills by relevance to a query
# Parses the skills registry and scores by trigger match, description match, and tier boost

set -euo pipefail

log_usage() {
  local f="$HOME/.cache/agent-workflows/skill-usage.jsonl"
  mkdir -p "$(dirname "$f")" 2>/dev/null || return 0
  printf '{"timestamp":"%s","skill_id":"%s","agent":"%s","workspace":"%s","success":%s,"duration_s":0,"notes":"%s"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$(a="${AI_AGENT:+${AI_AGENT%%_*}}"; echo "${a:-cli}")" "$PWD" "$2" "$3" >> "$f" 2>/dev/null || true
}

usage() {
  echo "Usage: skill-rank <query> [--top <N>] [--tier <tier>] [--json]"
  echo ""
  echo "Rank skills by relevance to a query string."
  echo ""
  echo "Options:"
  echo "  --top <N>     Return top N results (default: 5)"
  echo "  --tier <tier> Filter to specific tier only"
  echo "  --json        Output as JSON instead of text"
  exit 1
}

# Main
main() {
  if [[ $# -lt 1 ]]; then
    usage
  fi
  
  local query=""
  local top_n=5
  local tier_filter=""
  local json_output=0
  
  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case $1 in
      --top)
        top_n="$2"
        shift 2
        ;;
      --tier)
        tier_filter="$2"
        shift 2
        ;;
      --json)
        json_output=1
        shift
        ;;
      *)
        if [[ -z "$query" ]]; then
          query="$1"
        else
          echo "Error: Unknown argument: $1" >&2
          usage
        fi
        shift
        ;;
    esac
  done
  
  if [[ -z "$query" ]]; then
    echo "Error: Query is required" >&2
    usage
  fi
  
  # Use Python for efficient YAML parsing and scoring
  python3 - "$query" "$top_n" "$tier_filter" "$json_output" << 'PYEOF'
import yaml
import json
import sys

# Read registry
with open('$AGENT_OS_HOME/registry/skills.yaml', 'r') as f:
    content = f.read()

# Parse YAML manually to handle comments
skills = []
current_skill = None
in_trigger_list = False

for line in content.split('\n'):
    stripped = line.strip()
    
    # Skip empty lines and comments
    if not stripped or stripped.startswith('#'):
        continue
    
    # New skill entry
    if stripped.startswith('- name:'):
        if current_skill is not None:
            skills.append(current_skill)
        name = stripped.split(':', 1)[1].strip()
        current_skill = {
            'name': name,
            'tier': '',
            'status': '',
            'path': '',
            'triggers': [],
            'description': ''
        }
        in_trigger_list = False
        continue
    
    if current_skill is None:
        continue
    
    # Parse fields
    if stripped.startswith('tier:'):
        current_skill['tier'] = stripped.split(':', 1)[1].strip()
    elif stripped.startswith('status:'):
        current_skill['status'] = stripped.split(':', 1)[1].strip()
    elif stripped.startswith('path:'):
        current_skill['path'] = stripped.split(':', 1)[1].strip()
    elif stripped.startswith('description:'):
        desc = stripped.split(':', 1)[1].strip()
        # Remove surrounding quotes
        if desc.startswith('"') and desc.endswith('"'):
            desc = desc[1:-1]
        current_skill['description'] = desc
    elif stripped.startswith('trigger:'):
        in_trigger_list = True
    elif in_trigger_list and stripped.startswith('-'):
        trigger = stripped.split('-', 1)[1].strip()
        current_skill['triggers'].append(trigger)
    elif in_trigger_list and not stripped.startswith('-'):
        in_trigger_list = False

# Add last skill
if current_skill is not None:
    skills.append(current_skill)

# Get query from command line args
query = sys.argv[1]
top_n = int(sys.argv[2])
tier_filter = sys.argv[3] if sys.argv[3] else ''
json_output = sys.argv[4] == '1'

# Score and rank skills
results = []

for skill in skills:
    # Skip deprecated/archived
    if skill['status'] in ('deprecated', 'archived'):
        continue
    
    # Apply tier filter
    if tier_filter and skill['tier'] != tier_filter:
        continue
    
    # Calculate trigger match (0.0-0.5)
    trigger_score = 0.0
    if skill['triggers']:
        query_words = query.lower().split()
        matching_words = 0
        
        for word in query_words:
            for trigger in skill['triggers']:
                if word in trigger.lower() or trigger.lower() in word:
                    matching_words += 1
                    break
        
        if query_words:
            trigger_score = min(0.5, (matching_words / len(query_words)) * 0.5)
    
    # Calculate description match (0.0-0.3)
    desc_score = 0.0
    if skill['description']:
        query_words = query.lower().split()
        desc_lower = skill['description'].lower()
        matching_desc_words = 0
        
        for word in query_words:
            if word in desc_lower:
                matching_desc_words += 1
        
        if query_words:
            desc_score = min(0.3, (matching_desc_words / len(query_words)) * 0.3)
    
    # Calculate tier boost (0.0-0.2)
    tier_score = 0.05
    if skill['tier'] == 'os-shared':
        tier_score = 0.20
    elif skill['tier'].startswith('workspace-'):
        tier_score = 0.15
    elif skill['tier'] == 'personal':
        tier_score = 0.10
    
    total_score = trigger_score + desc_score + tier_score
    
    results.append({
        'name': skill['name'],
        'score': total_score,
        'tier': skill['tier'],
        'description': skill['description'],
        'path': skill['path']
    })

# Sort by score descending
results.sort(key=lambda x: x['score'], reverse=True)

# Output results
if json_output:
    print(json.dumps(results[:top_n], indent=2))
else:
    print(f'# Skill Ranking for: "{query}"')
    for i, result in enumerate(results[:top_n], 1):
        print(f"{i}. {result['name']} (score={result['score']:.2f}, tier={result['tier']}) — {result['description']}")
PYEOF
  local safe_query
  safe_query=$(printf '%s' "$query" | tr -d '"')
  log_usage "skill-rank" 1 "query:${safe_query:0:60}"
}

main "$@"
